---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Phone from './Phone.astro';
import { t, links, chapters, fmtTime, type Lang } from '../data/content';
import { appShots, refShots } from '../lib/images';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t[lang].tour;
const poster = await getImage({ src: appShots.login!, width: 720, format: 'webp' });
// Full-size versions for the lightbox, rendered once at build time.
const zoom = Object.fromEntries(await Promise.all(Object.entries(refShots).map(async ([k, img]) =>
  [k, (await getImage({ src: img, width: Math.min(img.width, 1400), format: 'webp' })).src] as const)));
---
<section id="tour" class="tour">
  <div class="wrap">
    <p class="eyebrow reveal"><b>02</b>{t[lang].nav.tour}</p>
    <h2 class="section-title reveal">{c.title}</h2>
    <p class="section-intro reveal">{c.intro}</p>

    <div class="stage" data-tour>
      <div class="player">
        <Phone size="lg">
          <video data-video controls playsinline preload="metadata" poster={poster.src} aria-label={c.video}>
            <source src={links.video} type="video/mp4" />
          </video>
        </Phone>
      </div>

      <nav class="chapters" aria-label={c.chapters}>
        <p class="label mono">{c.chapters} · {chapters.length}</p>
        <ol data-list>
          {chapters.map((ch, i) => (
            <li>
              <button type="button" data-seek={ch.start} data-chapter={ch.id} aria-current={i === 0 ? 'step' : undefined}>
                <span class="time mono">{fmtTime(ch.start)}</span>
                <span class="name">{ch.title[lang]}</span>
              </button>
            </li>
          ))}
        </ol>
      </nav>

      <div class="details" aria-live="polite">
        {chapters.map((ch, i) => (
          <article class="card detail" data-detail={ch.id} id={`ch-${ch.id}`} hidden={i !== 0 ? true : undefined}>
            <header>
              <span class="num mono">{String(i + 1).padStart(2, '0')} / {chapters.length}</span>
              <h3>{ch.title[lang]}</h3>
            </header>
            <p>{ch.text[lang]}</p>
            <button type="button" class="play mono" data-seek={ch.start}><Icon name="play" />{c.play} · {fmtTime(ch.start)}</button>
            {ch.refs.length > 0 && (
            <div class="refs">
              <p class="label mono">{c.original}</p>
                <div class="thumbs">
                  {ch.refs.map((r) => (
                    <button type="button" class="thumb" data-zoom={zoom[r]} data-caption={`${ch.title[lang]} · ${c.original}`}>
                      <Image src={refShots[r]!} alt={`${c.original}: ${ch.title[lang]}`} width={360} />
                      <span class="z"><Icon name="zoom" /></span>
                    </button>
                  ))}
                </div>
            </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tour { background: linear-gradient(var(--bg), var(--bg-2) 25%, var(--bg-2) 75%, var(--bg)); }
  .stage { display: grid; grid-template-columns: auto 230px minmax(0, 1fr); gap: 28px; margin-top: 48px; align-items: start; }
  .player { position: sticky; top: 88px; }
  .player :global(video) { background: #000; object-fit: contain; }

  .chapters { position: sticky; top: 88px; max-height: calc(100vh - 110px); display: flex; flex-direction: column; }
  .label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  ol { list-style: none; margin: 0; padding: 0 4px 0 0; overflow-y: auto; display: grid; gap: 2px; scrollbar-width: thin; }
  ol button {
    width: 100%; display: flex; gap: 10px; align-items: baseline; text-align: left; padding: 9px 12px; border-radius: 10px;
    border: 1px solid transparent; background: none; color: var(--text-2); font: inherit; font-size: 0.9rem; cursor: pointer; transition: background 0.2s, color 0.2s;
  }
  ol button:hover { background: var(--surface); color: var(--text); }
  ol button[aria-current] { background: var(--surface); color: var(--text); border-color: var(--accent); }
  .time { font-size: 0.75rem; color: var(--muted); min-width: 34px; }
  [aria-current] .time { color: var(--accent); }

  .details { min-width: 0; display: grid; gap: 16px; }
  .detail { padding: clamp(20px, 3vw, 30px); display: flex; flex-direction: column; gap: 14px; }
  .detail::before { display: none; }
  .num { font-size: 0.75rem; color: var(--accent); }
  h3 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-top: 6px; }
  .detail > p { color: var(--text-2); font-size: 1rem; }
  .play { align-self: flex-start; display: inline-flex; gap: 8px; align-items: center; font-size: 0.8rem; padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: none; color: var(--text); cursor: pointer; }
  .play:hover { border-color: var(--accent); color: var(--accent); }
  .play :global(svg) { width: 12px; height: 12px; }
  .refs { margin-top: 6px; padding-top: 16px; border-top: 1px solid var(--line); }
  .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .thumb { position: relative; padding: 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: #fff; cursor: zoom-in; aspect-ratio: 4 / 3; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform 0.4s var(--ease); }
  .thumb:hover :global(img) { transform: scale(1.04); }
  .z { position: absolute; right: 8px; bottom: 8px; width: 30px; height: 30px; border-radius: 50%; background: rgb(0 0 0 / 0.7); color: #fff; display: grid; place-items: center; }
  .z :global(svg) { width: 15px; height: 15px; }

  /* `display: flex` above would override the hidden attribute, so hide explicitly …
     … except without JavaScript, where every chapter is shown, one below the other. */
  .detail[hidden] { display: none; }
  :global(html:not(.js)) .detail[hidden] { display: flex; }

  @media (max-width: 1100px) {
    .stage { grid-template-columns: auto minmax(0, 1fr); }
    .chapters { grid-column: 2; grid-row: 1; position: static; max-height: 420px; }
    .details { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    /* minmax(0, …): the horizontal chapter strip must scroll, not widen the column. */
    .stage { grid-template-columns: minmax(0, 1fr); }
    .chapters { min-width: 0; }
    .player { position: static; display: flex; justify-content: center; }
    .player :global(.phone) { --w: 280px; }
    .chapters { grid-column: auto; grid-row: auto; max-height: none; }
    ol { display: flex; overflow-x: auto; gap: 8px; padding-bottom: 6px; scroll-snap-type: x mandatory; }
    ol li { flex: none; scroll-snap-align: start; }
    ol button { flex-direction: column; gap: 2px; border-color: var(--line); background: var(--surface); width: auto; white-space: nowrap; }
  }
</style>
