---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Phone from './Phone.astro';
import { t, links, chapters, type Lang } from '../data/content';
import { appShots } from '../lib/images';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t[lang].hero;
const facts = [chapters.length, 8, 4];
---
<section class="hero">
  <div class="bg" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="copy">
      <p class="badge reveal"><span></span>{c.badge}</p>
      <p class="kicker mono reveal" style="--i:1">{c.kicker}</p>
      <h1 class="reveal" style="--i:1">{c.title[0]}<br /><em>{c.title[1]}</em></h1>
      <p class="lead reveal" style="--i:2">{c.lead}</p>
      <div class="ctas reveal" style="--i:3">
        <a class="btn btn-primary" href="#tour"><Icon name="play" />{c.ctaTour}</a>
        <a class="btn" href={links.apk} download><Icon name="download" />{c.ctaApk}</a>
      </div>
      <dl class="facts reveal" style="--i:4">
        {facts.map((n, i) => <div><dd>{n}</dd><dt>{c.facts[i]}</dt></div>)}
      </dl>
    </div>
    <div class="phones reveal" style="--i:2" aria-hidden="true">
      <Phone size="sm" class="back"><Image src={appShots.messaging} alt="" width={400} /></Phone>
      <Phone size="lg" class="front"><Image src={appShots.dashboard} alt="" width={680} loading="eager" /></Phone>
      <div class="toast">
        <span class="ti"><Icon name="bell" /></span>
        <span><strong>EmmaInBerlin</strong><small>Hey! I just saw your profile …</small></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 96px); overflow: hidden; isolation: isolate; }
  .bg { position: absolute; inset: 0; z-index: -1; background:
      radial-gradient(600px circle at 78% 30%, var(--glow), transparent 60%),
      radial-gradient(var(--line-strong) 1px, transparent 1px) 0 0 / 26px 26px;
    mask-image: linear-gradient(#000 60%, transparent); }
  .grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .badge { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 600; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--text-2); }
  .badge span { width: 7px; height: 7px; border-radius: 50%; background: var(--building); }
  .kicker { margin-top: 22px; font-size: 0.8rem; color: var(--muted); }
  h1 { font-size: clamp(2.4rem, 6.4vw, 4.8rem); line-height: 1; letter-spacing: -0.035em; margin-top: 12px; font-weight: 700; }
  h1 em { font-style: normal; color: var(--accent); }
  .lead { margin-top: 22px; font-size: clamp(1.02rem, 1.6vw, 1.18rem); color: var(--text-2); max-width: 54ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 40px 0 0; max-width: 480px; }
  .facts div { display: flex; flex-direction: column; gap: 4px; border-top: 1px solid var(--line-strong); padding-top: 12px; }
  .facts dd { margin: 0; font: 700 2rem/1 var(--font-display); }
  .facts dt { font-size: 0.8rem; color: var(--text-2); }

  .phones { position: relative; display: flex; justify-content: center; padding: 20px 0 40px; }
  .phones :global(.front) { position: relative; z-index: 2; transform: rotate(2deg); }
  .phones :global(.back) { position: absolute; left: 0; top: 70px; z-index: 1; transform: rotate(-7deg); opacity: 0.85; }
  .toast {
    position: absolute; z-index: 3; right: 0; top: 36px; display: flex; gap: 10px; align-items: center; max-width: 250px;
    padding: 10px 14px; border-radius: 16px; background: rgb(255 255 255 / 0.92); color: #111; box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.6);
    animation: pop 0.6s 0.8s both cubic-bezier(0.2, 0.9, 0.2, 1.2);
  }
  .toast strong { display: block; font-size: 0.85rem; }
  .toast small { display: block; font-size: 0.78rem; color: #555; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
  .ti { width: 32px; height: 32px; border-radius: 10px; background: #e8834a; color: #fff; display: grid; place-items: center; flex: none; }
  .ti :global(svg) { width: 16px; height: 16px; }
  @keyframes pop { from { opacity: 0; transform: translateY(-12px) scale(0.95); } }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .phones { order: -1; }
    .phones :global(.front) { --w: 240px; }
    .phones :global(.back) { --w: 160px; left: calc(50% - 210px); }
    .toast { right: calc(50% - 200px); }
  }
  @media (max-width: 480px) {
    .phones :global(.back) { display: none; }
    .toast { right: 8px; top: 8px; }
  }
</style>
